# Miyoo Mini Plus additions on top of mstar_defconfig:
#   make ARCH=arm mstar_defconfig miyoo_mini_plus.config
CONFIG_ARCH_MSTARV7=y
CONFIG_MACH_INFINITY=y
CONFIG_POWER_SUPPLY=y
CONFIG_AXP20X_ADC=y
CONFIG_BATTERY_AXP20X=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
# SoC drivers the project defconfig lost (it was saved without ARCH_MSTARV7)
CONFIG_DRM_MSTAR=y
CONFIG_I2C_MSC313E=y
CONFIG_MMC_MSTAR_FCIE=y
CONFIG_PWM_MSC313E=y
CONFIG_MSC313E_WATCHDOG=y
CONFIG_MSTAR_MSC313_CMDQ=y
CONFIG_SSTAR_SSD20XD_MOVEDMA=y
CONFIG_NVMEM_MSC313_DID=y
CONFIG_NVMEM_MSC313_EFUSE=y
CONFIG_HW_RANDOM_MSC313=y
CONFIG_SND_MSTAR_INFINITY=y
# Defaults to y only with the arch timer, which mstar_defconfig lacks
CONFIG_VDSO=y
# Wi-Fi: EHCI on the SoC's USB ports and the RTL8188FU driver
# (needs rtlwifi/rtl8188fufw.bin from linux-firmware in the rootfs)
CONFIG_USB_FOTG210_HCD=y
CONFIG_RTL8XXXU=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

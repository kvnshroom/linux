/*
 * Copyright (c) 2021 thingy.jp.
 * Author: Daniel Palmer <daniel@thingy.jp>
 *
 * Miyoo Mini Plus, derived from the Miyoo Mini board file. Pads come from
 * the vendor kernel's GPIO number table; levels and directions were read
 * from a running unit. See the notes next to each difference.
 */

/dts-v1/;
#include "mstar-infinity2m-ssd202d.dtsi"

/ {
	model = "Miyoo Mini Plus";
	compatible = "miyoo,miyoo-mini-plus", "mstar,infinity2m";

	aliases {
		serial0 = &pm_uart;
	};

	chosen {
		stdout-path = "serial0:38400n8";
		bootargs = "console=ttyS0,115200 clk_ignore_unused earlyprintk root=/dev/mmcblk0p2 ro rootfstype=squashfs rootwait";
	};

	/*
	 * Vendor GPIO numbers in the comments. Every key was pressed on a
	 * real unit while its pad level was read: all are active low, and
	 * only the volume keys (TTL23/TTL24) and the power key (SAR0) differ
	 * from the Mini.
	 */
	gpio-keys {
		compatible = "gpio-keys-polled";
		poll-interval = <10>;

		key_up {	/* 1 */
			label = "key_up";
			gpios = <&gpio SSD20XD_GPIO_GPIO1 GPIO_ACTIVE_LOW>;
			linux,code = <103>; /* KEY_UP */
		};

		key_down {	/* 69 */
			label = "key_down";
			gpios = <&gpio_pm SSD20XD_PM_LED0 GPIO_ACTIVE_LOW>;
			linux,code = <108>; /* KEY_DOWN */
		};

		key_left {	/* 70 */
			label = "key_left";
			gpios = <&gpio_pm SSD20XD_PM_LED1 GPIO_ACTIVE_LOW>;
			linux,code = <105>; /* KEY_LEFT */
		};

		key_right {	/* 5 */
			label = "key_right";
			gpios = <&gpio SSD20XD_GPIO_GPIO5 GPIO_ACTIVE_LOW>;
			linux,code = <106>; /* KEY_RIGHT */
		};

		key_a {		/* 7 */
			label = "key_a";
			gpios = <&gpio SSD20XD_GPIO_GPIO7 GPIO_ACTIVE_LOW>;
			linux,code = <30>; /* KEY_A */
		};

		key_b {		/* 6 */
			label = "key_b";
			gpios = <&gpio SSD20XD_GPIO_GPIO6 GPIO_ACTIVE_LOW>;
			linux,code = <48>; /* KEY_B */
		};

		key_y {		/* 8 */
			label = "key_y";
			gpios = <&gpio SSD20XD_GPIO_GPIO8 GPIO_ACTIVE_LOW>;
			linux,code = <21>; /* KEY_Y */
		};

		key_x {		/* 9 */
			label = "key_x";
			gpios = <&gpio SSD20XD_GPIO_GPIO9 GPIO_ACTIVE_LOW>;
			linux,code = <45>; /* KEY_X */
		};

		key_start {	/* 10 */
			label = "key_start";
			gpios = <&gpio SSD20XD_GPIO_GPIO10 GPIO_ACTIVE_LOW>;
			linux,code = <28>; /* KEY_ENTER */
		};

		key_select {	/* 11 */
			label = "key_select";
			gpios = <&gpio SSD20XD_GPIO_GPIO11 GPIO_ACTIVE_LOW>;
			linux,code = <1>; /* KEY_ESC */
		};

		key_menu {	/* 12 */
			label = "key_menu";
			gpios = <&gpio SSD20XD_GPIO_GPIO12 GPIO_ACTIVE_LOW>;
			linux,code = <139>; /* KEY_MENU */
		};

		key_l {		/* 14 */
			label = "key_l";
			gpios = <&gpio SSD20XD_GPIO_GPIO14 GPIO_ACTIVE_LOW>;
			linux,code = <16>; /* KEY_Q */
		};

		key_l2 {	/* 13 */
			label = "key_l2";
			gpios = <&gpio SSD20XD_GPIO_GPIO13 GPIO_ACTIVE_LOW>;
			linux,code = <17>; /* KEY_W */
		};

		key_r {		/* 47 */
			label = "key_r";
			gpios = <&gpio SSD20XD_GPIO_UART0_RX GPIO_ACTIVE_LOW>;
			linux,code = <18>; /* KEY_E */
		};

		key_r2 {	/* 90 */
			label = "key_r2";
			gpios = <&gpio SSD20XD_GPIO_GPIO90 GPIO_ACTIVE_LOW>;
			linux,code = <19>; /* KEY_R */
		};

		key_voldown {	/* 42 */
			label = "key_voldown";
			gpios = <&gpio SSD20XD_GPIO_TTL23 GPIO_ACTIVE_LOW>;
			linux,code = <114>; /* KEY_VOLUMEDOWN */
		};

		key_volup {	/* 43 */
			label = "key_volup";
			gpios = <&gpio SSD20XD_GPIO_TTL24 GPIO_ACTIVE_LOW>;
			linux,code = <115>; /* KEY_VOLUMEUP */
		};

		key_power {	/* 71 */
			label = "key_power";
			gpios = <&sar 0 GPIO_ACTIVE_LOW>;
			linux,code = <116>; /* KEY_POWER */
		};
	};

	/* TODO: vibration motor pad not identified on the Plus yet. */

	reg_vcc_core: regulator-vcc-core {
		compatible = "regulator-gpio";
		regulator-name = "vcc_core";
		regulator-type = "voltage";
		regulator-min-microvolt = <950000>;
		regulator-max-microvolt = <1000000>;
		regulator-boot-on;
		regulator-ramp-delay = <12000>;
		gpios = <&sar 1 0>;
		states = <1000000 0x1
			  950000  0x0>;
	};

	reg_vcc_dram: regulator-vcc-dram {
		compatible = "regulator-fixed";
		regulator-name = "vcc_dram";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
		regulator-boot-on;
	};

	reg_vcc_io: regulator-vcc-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc_io";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
	};

	reg_vdd_sd: regulator-vdd-sd {
		compatible = "regulator-fixed";
		regulator-name = "sd_vdd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		/*
		 * The card is powered by driving GPIO0 LOW (confirmed on hardware).
		 * regulator-fixed takes the enable polarity from this gpio flag, so
		 * it must be GPIO_ACTIVE_LOW - a plain 0 (active-high) would drive
		 * GPIO0 high and leave the card unpowered.
		 */
		gpio = <&gpio SSD20XD_GPIO_GPIO0 GPIO_ACTIVE_LOW>;
	};

	reg_vbat: regulator-vbat {
		compatible = "regulator-fixed";
		regulator-name = "vbat";
		regulator-min-microvolt = <4200000>;
		regulator-max-microvolt = <4200000>;
		gpio = <&gpio SSD20XD_GPIO_GPIO85 0>;
		enable-active-high;
		regulator-always-on;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 50000>;
		brightness-levels = <0 4 8 16 32 64 128 255>;
		/*
		 * TODO: only the top (max) level currently lights the panel - the
		 * LED-boost driver seems to want a different PWM frequency/response.
		 * Default to max (index 7 = 255) so the screen is visible until that
		 * is tuned properly.
		 */
		default-brightness-level = <7>;
		pinctrl-names = "default";
		pinctrl-0 = <&pwm0_mode3_pins>;
	};
};

&cpu0 {
	cpu-supply = <&reg_vcc_core>;
};

/*
 * The shared 4 MiB CMA pool is too small for the display: a double-buffered
 * 640x480 primary already needs ~2.4 MiB, and the DRM/KMS stack needs another
 * scan-out buffer to compensate for the upside-down panel (see DirectFB2's
 * drmkms layer). Give it comfortable headroom.
 */
&cma {
	size = <0x1000000>; /* 16 MiB */
};

&pm_uart {
	status = "okay";
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_mode1_pins>;
	status = "okay";

	/*
	 * Battery, charger and power rails. Its interrupt line is not known,
	 * so only the parts that work without it are enabled. There is
	 * deliberately no regulators node: Linux must not switch off rails
	 * the vendor u-boot set up.
	 */
	pmic: pmic@34 {
		compatible = "x-powers,axp223";
		reg = <0x34>;

		ac_power_supply: ac-power {
			compatible = "x-powers,axp221-ac-power-supply";
			status = "disabled";	/* needs the PMIC interrupt */
		};

		axp_adc: adc {
			compatible = "x-powers,axp221-adc";
			#io-channel-cells = <1>;
		};

		battery_power_supply: battery-power {
			compatible = "x-powers,axp221-battery-power-supply";
		};
	};

	/* 0x3d: ALPU copy-protection chip, same as on the Mini. No driver. */
};

&miu {
	ddr-supply = <&reg_vcc_dram>;
};

&sdio {
	vmmc-supply = <&reg_vdd_sd>;
	vqmmc-supply = <&reg_vcc_io>;
	/* The microSD slot has no write-protect switch; say so, otherwise the
	 * core warns "host does not support reading read-only switch". */
	disable-wp;
	status = "okay";
};

&op2 {
	//assigned-clocks = <&clkgen MSC313_CLKGEN_MUXES SSD20XD_CLKGEN_SC_PIXEL 0>,
	//		  <&sc_gp_ctrl_muxes SSD20XD_SC_GP_HDMI_GATE_MUX>;
	//assigned-clock-parents = <&clkgen MSC313_CLKGEN_DIVIDERS MSC313_CLKGEN_GATE_9 GATE9_DIVIDEBY_4>;
	//			 <&clkgen MSC313_CLKGEN_DEGLITCHES SSD20XD_CLKGEN_SC_PIXEL 0>;
	/* Route the CRTC to the DSI (port@1); the default is TTL (port@0), which
	 * has no panel wired so the driver's bind fails with -ENODEV. The driver
	 * reads this with of_property_read_u8, so it must be a byte (/bits/ 8) -
	 * a plain <1> cell reads back as 0 (its first big-endian byte) = TTL. */
	mstar,op2-output = /bits/ 8 <1>;
	status = "okay";
};

&op2_dsi {
	remote-endpoint = <&dsi_in>;
};

&dsi {
	status = "okay";
	panel@0 {
		/* Sitronix ST7703 based, initialised by the vendor u-boot */
		compatible = "miyoo,mini-plus-panel";
		reg = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&tx_mipi_mode1_pins>;
		backlight = <&backlight>;
		dsi-lanes = <2>;
		/*
		 * No rotation: u-boot's init sequence sets MADCTL 0xc0, which
		 * should already flip the image in the panel (unconfirmed).
		 */
		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	ports {
		port@0 {
			reg = <0>;
			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
                };
                port@1 {
			reg = <1>;
			dsi_in: endpoint {
				remote-endpoint = <&op2_dsi>;
			};
		};
        };
};

/* On-chip BACH audio (codec + I2S), for the speaker/headphone output. */
&bach {
	status = "okay";
};
